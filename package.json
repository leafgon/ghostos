{
  "name": "ghostos",
  "version": "0.2.5",
  "description": "A reference LEAF graph parser implementation used by leafgon.com",
  "main": "lib/index.esm.js",
  "module": "lib/index.esm.js",
  "exports": {
    ".": {
      "types": "./lib/index.browser.d.ts",
      "import": "./lib/index.esm.js",
      "default": "./lib/index.esm.js"
    },
    "./core": {
      "types": "./lib/index.core.d.ts",
      "import": "./lib/index.core.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ci": "npm run fmt:check && npm run lint && npm run typecheck && npm run test",
    "dev": "vite",
    "test:ui": "npx vitest --ui",
    "test:run": "npx vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "build:node": "webpack --config webpack.node.config.js",
    "build:web": "webpack --config webpack.browser.config.js",
    "build:dev": "webpack --config webpack.browser.dev.config.mjs",
    "build:cjs": "node ./scripts/build-cjs.mjs",
    "build:types": "tsc --project tsconfig.json --declaration --allowJs --emitDeclarationOnly --outDir lib",
    "build": "npm run build:web && npm run build:node && npm run build:cjs && npm run build:types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leafgon/ghostos.git"
  },
  "keywords": [
    "LEAF",
    "dataflow-based programming",
    "graph-based programming",
    "transparent AI programming"
  ],
  "author": "Sunny Park",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leafgon/ghostos/issues"
  },
  "homepage": "https://github.com/leafgon/ghostos#readme",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@egjs/hammerjs": "^2.0.17",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/x-date-pickers": "^8.8.0",
    "@react-spring/web": "^10.0.3",
    "@react-spring/zdog": "^10.0.3",
    "@tweenjs/tween.js": "^25.0.0",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.10.0",
    "buffer": "^6.0.3",
    "classcat": "^5.0.5",
    "codemirror": "^5.65.19",
    "d3": "^7.9.0",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "fast-safe-stringify": "^2.1.1",
    "graphology": "^0.26.0",
    "graphql": "^16.11.0",
    "handlebars": "^4.7.8",
    "highest-power-two": "^1.0.2",
    "image-promise": "^7.0.1",
    "json-stringify-safe": "^5.0.1",
    "jzz": "^1.9.3",
    "lodash": "^4.17.21",
    "npm": "^11.4.2",
    "p-map": "^7.0.3",
    "path-browserify": "^1.0.1",
    "pretty-ms": "^9.2.0",
    "propagating-hammerjs": "^3.0.0",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^6.0.0",
    "react-loader-spinner": "^6.1.6",
    "react-player": "^3.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.3",
    "react-youtube": "^10.1.0",
    "rxjs": "^7.8.2",
    "tone": "^15.1.22",
    "use-resize-observer": "^9.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@babel/plugin-transform-private-property-in-object": "^7.28.6",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.29.0",
    "@playwright/experimental-ct-react": "^1.54.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/d3": "^7.4.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-zoom": "^3.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/ui": "^3.2.4",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.37.5",
    "graphql-hooks": "^8.2.0",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^28.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "playwright": "^1.54.1",
    "prettier": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-promise-tracker": "^2.1.1",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "webpack": "^5.100.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
